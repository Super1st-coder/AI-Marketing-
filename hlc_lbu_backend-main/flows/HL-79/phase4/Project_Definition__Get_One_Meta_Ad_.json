    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\ntype = _('Edit Fields').item.json.type\n\nif type == 'N':\n  meta_ads = _input.item.json.attributes.meta_ads\nelif type == 'R':\n  meta_ads = _input.item.json.attributes.meta_ads_remarketing\nelse:\n  meta_ads = {}\n\ntarget_meta_ad_id = _('Edit Fields').item.json.meta_ad_id \ntarget_meta_ad = {}\nfor m in meta_ads:\n  if int(m['id']) == int(target_meta_ad_id):\n    target_meta_ad = m\n    \n\n\nreturn { 'meta_ad' : target_meta_ad }"
      },
