# Application
APP_NAME=Data Backend Service
APP_VERSION=1.0.0
DEBUG=False

# API
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_NAME_DEFAULT=dbname

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret to send in the X-Internal-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FURY_INTERNAL_API_KEY=change_me_generate_a_random_secret

# Expected `aud` claim for Google Cloud OIDC tokens.
# Set to the public URL of this service, e.g. https://sec.hiluca.com
OIDC_AUDIENCE=https://sec.hiluca.com

# CORS
# Production: use explicit allowed origins.
# Development:
CORS_ORIGINS=["*"]
