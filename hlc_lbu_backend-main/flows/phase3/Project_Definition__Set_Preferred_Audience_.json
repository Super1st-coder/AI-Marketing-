      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\naudience = _input.all()[0].json.attributes.audience\n\ndesired_preferred = _('Edit Fields').all()[0].json.audience_id\npreferred_audience = {}\nfor b in audience:\n  if b.id == int(desired_preferred):\n    b.preferred = 1\n    preferred_audience = b\n  else:\n    b.preferred = 0\n\n\nreturn { 'audience' : audience, 'preferred_audience': preferred_audience }"
