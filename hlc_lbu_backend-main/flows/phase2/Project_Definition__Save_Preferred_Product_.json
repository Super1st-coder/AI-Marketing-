    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\nproducts = _input.all()[0].json.attributes.products\n\npreferred_product = _('Edit Fields').all()[0].json.preferred_product\npreferred_product = json.loads(preferred_product)\n\nnew_products = []\nfor b in products:\n  if int(b['Product'].id) == int(preferred_product['Product']['id']) :\n    new_products.append(preferred_product)\n  else:\n    new_products.append(b)    \n  \n    \nreturn { 'products' : new_products, 'preferred_product' : preferred_product }"
      },
