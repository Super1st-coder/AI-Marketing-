{
  "kind": "collectionType",
  "collectionName": "experiment_subcategories",
  "info": {
    "singularName": "experiment-subcategory",
    "pluralName": "experiment-subcategories",
    "displayName": "Experiment-Subcategory",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "custom": {
      "type": "boolean",
      "default": true
    },
    "category_ref": {
      "type": "relation",
