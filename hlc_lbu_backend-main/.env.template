# ══════════════════════════════════════════════════════════════════════════════
# .env.template – Variables requeridas por el stack de HiLuca LBU (AWS)
#
# CÓMO USAR:
#   1. Copia este archivo a .env.dev y llena los valores reales
#   2. Sube el .env.dev completo a AWS Secrets Manager:
#      aws secretsmanager put-secret-value \
#        --secret-id hiluca-lbu-dev-env \
#        --secret-string file://.env.dev
#   3. El GitHub Action lo descargará automáticamente al desplegar en EC2
#
# NUNCA subas este archivo (ni .env.dev) al repositorio de Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Infraestructura AWS (inyectadas automáticamente por el deploy) ─────────────
# No necesitas llenarlas aquí, el Action las agrega solo
DATABASE_HOST=hiluca-lbu-dev-postgres.cf6mg0eu2jo2.us-east-2.rds.amazonaws.com
DATABASE_PORT=5432
ECR_REGISTRY=861276093436.dkr.ecr.us-east-2.amazonaws.com

# ── Strapi ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
APP_KEYS=CHANGE_ME_key1,CHANGE_ME_key2,CHANGE_ME_key3,CHANGE_ME_key4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
DATABASE_USERNAME=hiluca
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME_STRAPI=strapi
DATABASE_SSL=false

# ── Sinergia (FastAPI) ─────────────────────────────────────────────────────────
CONFIG_TYPE=production
DATABASE_NAME_SINERGIA=sinergia

# Facebook / Meta
FACEBOOK_CLIENT_ID=CHANGE_ME
FACEBOOK_CLIENT_SECRET=CHANGE_ME
FACEBOOK_REDIRECT_URI=https://api.dev.hiluca.com/sinergia/auth/facebook/callback
FACEBOOK_GRAPH_API_BASE=https://graph.facebook.com

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_HOST=mongodb
MONGODB_PORT=27017

# ── N8N ────────────────────────────────────────────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
WEBHOOK_URL=https://api.dev.hiluca.com/n8n/

# ── Strapi Tags (usados por docker-compose) ────────────────────────────────────
STRAPI_TAG=latest
SINERGIA_TAG=latest
