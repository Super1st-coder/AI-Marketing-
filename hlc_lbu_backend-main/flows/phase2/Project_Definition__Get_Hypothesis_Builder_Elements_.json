        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\ngoal_attributes = _('If1').all()[0].json.attributes.goal_attributes_saved\nhypothesis_elements = _('If1').all()[0].json.attributes.hypothesis_element_attributes_saved\n\npreferred_buyer_person_name =  _('If1').all()[0].json.attributes.preferred_buyer_person.Buyer_Persona.Name\npreferred_buyer_person_title = _('If1').all()[0].json.attributes.preferred_buyer_person.Buyer_Persona.Title \n\npreferred_buyer_person = ' - '.join([preferred_buyer_person_name,preferred_buyer_person_title])\n\nreturn { 'goals' : goal_attributes, 'hypothesis_elements' : hypothesis_elements, 'buyer_person' : preferred_buyer_person  }"
