# Database Configuration
DATABASE_USERNAME=username
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME_SINERGIA=database

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017

# N8N Configuration
N8N_HOST=localhost
N8N_PORT=5678

# Frontend Configuration
FRONT_HOST=localhost
FRONT_PORT=3000

# Configuration Type
CONFIG_TYPE=dev

# UNSPLASH
UNSPLASH_ACCESS_KEY=UNSPLASH_API
UNSPLASH_ACCESS_SECRET=UNSPLASH_ACCESS_SECRET
UNSPLASH_API=UNSPLASH_API

# FACEBOOK
FACEBOOK_CLIENT_ID=FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=FACEBOOK_CLIENT_SECRET
FACEBOOK_REDIRECT_URI=FACEBOOK_REDIRECT_URI
FACEBOOK_GRAPH_API_BASE=FACEBOOK_GRAPH_API_BASE

# Image Library
IMAGE_LIBRARY_URL=IMAGE_LIBRARY_URL
IMAGE_LIBRARY_TOKEN=IMAGE_LIBRARY_TOKEN

FONT_BUCKET_NAME=FONT_BUCKET_NAME

# Fury API
FURY_URL=http://fury:8000
# Shared secret — must match FURY_INTERNAL_API_KEY in Fury's .env
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FURY_SERVICE_API_KEY=change_me_must_match_fury_internal_api_key

# Google Cloud Storage
# On Compute Engine the service account attached to the VM is used automatically (ADC).
# No JSON key file required.
GCS_BUCKET_NAME=your-gcs-bucket-name
# Seconds a signed URL remains valid (default: 900 = 15 min)
GCS_SIGNED_URL_EXPIRATION=900
# Service Account key JSON for signed URL generation (paste full JSON content, one line).
# Required on VMs whose OAuth scopes don't include 'iam'.
# Leave empty to use ADC (requires iam scope + roles/iam.serviceAccountTokenCreator).
GCS_SA_KEY_JSON=
