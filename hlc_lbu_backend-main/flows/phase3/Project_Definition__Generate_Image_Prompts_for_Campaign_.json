        "pythonCode": "import json\n\noutput = _input.all()[0].json.output\njson_output = json.loads(output)\n\nid = 0\nfor j in json_output:\n  j['id'] = id   \n  j['preferred'] = 0\n  id += 1\n\n\nreturn {'json_output': json_output}"
