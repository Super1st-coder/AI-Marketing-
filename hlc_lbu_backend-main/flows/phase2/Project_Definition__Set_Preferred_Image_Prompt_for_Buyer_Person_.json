      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimage_prompts = _input.all()[0].json.attributes.buyer_person_image_prompts\n\ndesired_selected = _('Edit Fields').all()[0].json.buyer_person_image_prompt_id\nselected_image_prompt = {}\nfor b in image_prompts:\n  b.preferred = 0\n  if b.id == int(desired_selected):\n    b.preferred = 1\n    selected_image_prompt = b\n    \nreturn { 'buyer_person_image_prompts' : image_prompts, 'selected_buyer_person_image_prompt': selected_image_prompt }"
