{
  "name": "hiluca",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#styles/main.css": "./src/styles/main.css"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check-router": "vue-tsc --noEmit src/router/index.ts",
    "type-check-staged": "vue-tsc --noEmit",
    "type-check-commit": "vue-tsc --noEmit",
    "test-precommit": "vue-tsc --noEmit",
    "generate-types": "vite build --mode production --emptyOutDir false --outDir temp-types && rm -rf temp-types",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "prettier --write"
    ],
    "*.{js,jsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@intlify/unplugin-vue-i18n": "^5.3.1",
    "@tanstack/vue-query": "^5.72.0",
    "@types/lodash": "^4.17.24",
    "@vee-validate/yup": "^4.15.0",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/router": "^14.3.0",
    "apexcharts": "^6.10.0",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "destr": "^2.0.3",
    "focus-trap": "^7.6.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "maska": "^3.2.0",
    "ofetch": "^1.4.0",
    "pinia": "^4.0.2",
    "posthog-js": "^1.268.9",
    "universal-cookie": "^7.2.2",
    "vee-validate": "^4.15.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.40",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^10.0.4",
    "vue-router": "^5.2.0",
    "vue3-apexcharts": "^1.11.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.1.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@iconify/vue": "^5.0.1",
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/vue3-vite": "^10.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "dotenv": "^17.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.93.2",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
