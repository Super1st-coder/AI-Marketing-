        "messages": {
          "values": [
            {
              "content": "=Based on the following competitive advantage description ‘{{ $json[\"advantages_description\"] }}’, generate 5 categories that represent how the product solves the buyer’s challenge better than others. For each category, provide 5 specific advantages. Ensure each item is 25 characters or less and tied to the competitive advantage.\n\nThe output must be a JSON File, we need show for each identified category as an array of elements, each element should be of type string, for output should be similar and mandatory to the next example:\n\n{ \n  \"<category 1>\" : [ <Item of category 1>,<Item of category 1>,...,<Item of category 1> ],\n  \"<category 2>\" : [ <Item of category 2>,<Item of category 2>,...,<Item of category 2> ],\n  \"<category 3>\" : [ <Item of category 3>,<Item of category 3>,...,<Item of category 3> ],\n  \"<category 4>\" : [ <Item of category 4>,<Item of category 4>,...,<Item of category 4>],\n  \"<category 5>\" : [ <Item of category 5>,<Item of category 5>,...,<Item of category 5> ]\n}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
