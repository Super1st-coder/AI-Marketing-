    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\nbuyer_persons = _input.all()[0].json.attributes.buyer_persons\n\npreferred_buyer_person = _('Edit Fields').all()[0].json.preferred_buyer_person\npreferred_buyer_person = json.loads(preferred_buyer_person)\n\nnew_buyer_persons = []\nfor b in buyer_persons:\n  if int(b['Buyer_Persona'].id) == int(preferred_buyer_person['Buyer_Persona']['id']) :\n    new_buyer_persons.append(preferred_buyer_person)\n  else:\n    new_buyer_persons.append(b)    \n  \n    \nreturn { 'buyer_persons' : new_buyer_persons, 'preferred_buyer_person' : preferred_buyer_person }"
      },
