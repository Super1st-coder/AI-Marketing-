    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\naudience = _input.all()[0].json.attributes.audience\n\npreferred_audience = _('Edit Fields').all()[0].json.preferred_audience\npreferred_audience = json.loads(preferred_audience)\n\nnew_audience = []\nfor b in audience:\n  if int(b.id) == int(preferred_audience['id']) :\n    new_audience.append(preferred_audience)\n  else:\n    new_audience.append(b)    \n  \n    \nreturn { 'audience' : audience, 'preferred_audience' : preferred_audience }"
      },
