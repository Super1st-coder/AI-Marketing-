      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\ncampaigns = _input.all()[0].json.attributes.campaigns\n\ndesired_preferred = _('Edit Fields').all()[0].json.campaign_id\npreferred_campaign = {}\n\nfor b in campaigns:\n  if b.id == int(desired_preferred):\n    b.preferred = 1\n    preferred_campaign = b\n  else:\n    b.preferred = 0\n\n\nreturn { 'campaigns' : campaigns, 'preferred_campaign': preferred_campaign }"
