│       ├── image_tools.py           ← generate_image_concept, call_image_api
│       ├── abyssale_tools.py        ← build_payload, post_to_abyssale
│       └── validation_tools.py     ← check_diversity, check_fidelity
├── api/v2/endpoints/
│   ├── experiments.py               ← POST /experiments
│   ├── jobs.py                      ← POST /jobs/{id}/start, GET /jobs/{id}
│   └── webhooks.py                  ← POST /webhooks/abyssale, /webhooks/ai-expansion
├── services/
│   └── job_runner_service.py        ← lanza y gestiona el BackgroundTask ADK
├── core/
│   └── adk_config.py               ← InMemorySessionService, get_runner()
└── schemas/
    ├── experiment_schemas.py
    └── job_schemas.py
```

---

### Root Orchestrator Agent

#### [NEW] `agents/root_orchestrator.py`

```python
from google.adk.agents import Agent
from agents.estratega_agent import estratega_agent
from agents.copywriter_agent import copywriter_agent
from agents.nano_banana_agent import nano_banana_agent
from agents.template_mapper_agent import template_mapper_agent
from agents.validador_agent import validador_agent

root_orchestrator = Agent(
    model="gemini-2.0-flash",
    name="fury_orchestrator",
    description="Orquesta la generación completa de ads para un job.",
    instruction="""
    Eres el orquestador principal del pipeline de generación de ads.

    Sigue estos pasos en orden:
    1. Llama a estratega_agent con el job_id para obtener N planes creativos.
    2. Para cada plan, llama en paralelo a:
       - copywriter_agent para generar textos.
       - nano_banana_agent para generar conceptos de imagen.
    3. Llama a template_mapper_agent con los textos e imágenes para construir
       el payload de Abyssale. El template_mapper también llama a Abyssale.
    4. Cuando el webhook de Abyssale llegue (ya guardado en DB), llama a
       validador_agent con los renders resultantes.
    5. Si el validador aprueba, termina con status=DONE.
       Si falla, repite desde el paso 1 solo para el subset indicado.
    """,
    sub_agents=[
        estratega_agent,
        copywriter_agent,
        nano_banana_agent,
        template_mapper_agent,
        validador_agent,
    ],
)
```

---

### Job Runner Service

#### [NEW] `services/job_runner_service.py`

```python
import asyncio
from google.adk.runners import Runner
from agents.root_orchestrator import root_orchestrator
from core.adk_config import session_service
from google.genai import types

async def run_job(job_id: str, experiment_data: dict):
    """Corre el pipeline ADK como background task."""
    runner = Runner(
        agent=root_orchestrator,
        app_name="fury",
        session_service=session_service,
    )
    session = await session_service.create_session(
        app_name="fury", user_id=job_id
    )
    message = types.Content(
        role="user",
        parts=[types.Part(text=f"Genera ads para job_id={job_id}: {experiment_data}")]
    )
    async for event in runner.run_async(
        user_id=job_id,
        session_id=session.id,
        new_message=message,
    ):
        if event.is_final_response():
            await mark_job_done(job_id, event.content)
```

---

### Endpoints nuevos

#### [NEW] `api/v2/endpoints/jobs.py`

```python
@router.post("/{job_id}/start")
async def start_job(job_id: str, background_tasks: BackgroundTasks, db=Depends(get_db)):
    job = await db.get_job(job_id)
    experiment = await db.get_experiment(job.experiment_id)
    background_tasks.add_task(run_job, job_id, experiment.dict())
    return {"ok": 1, "status": "running"}

@router.get("/{job_id}")
async def get_job_status(job_id: str, db=Depends(get_db)):
    job = await db.get_job(job_id)
    return {"ok": 1, "data": job}
```

#### [NEW] `api/v2/endpoints/webhooks.py`

```python
@router.post("/abyssale")
async def abyssale_webhook(payload: dict, db=Depends(get_db)):
    # Guarda renders, actualiza job, dispara AI Expansion
    ...

@router.post("/ai-expansion/result")
async def ai_expansion_result(payload: dict, db=Depends(get_db)):
    # Guarda formatos derivados, señaliza que el validador puede continuar
    ...
```

