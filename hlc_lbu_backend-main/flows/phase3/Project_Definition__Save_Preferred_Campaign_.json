    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\ncampaigns = _input.all()[0].json.attributes.campaigns\n\npreferred_campaign = _('Edit Fields').all()[0].json.preferred_campaign\npreferred_campaign = json.loads(preferred_campaign)\n\nnew_campaigns = []\nfor b in campaigns:\n  if int(b.id) == int(preferred_campaign['id']) :\n    new_campaigns.append(preferred_campaign)\n  else:\n    new_campaigns.append(b)    \n  \n    \nreturn { 'campaigns' : campaigns, 'preferred_campaign' : preferred_campaign }"
      },
