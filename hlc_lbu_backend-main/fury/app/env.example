# Application
APP_NAME=Fury API
APP_VERSION=1.0.0
DEBUG=False

# API
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# Strapi
STRAPI_URL=http://strapi:1337
STRAPI_TOKEN=your_strapi_token_here

# N8N
N8N_URL=http://n8n:5678

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_NAME_DEFAULT=dbname

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=1.2

# Langfuse
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=demo-rag-es
LANGFUSE_PROMPT_LABEL=production

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret Sinergia must send in the X-Internal-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FURY_INTERNAL_API_KEY=change_me_generate_a_random_secret

# Expected `aud` claim for Google Cloud OIDC tokens (Agent Engine endpoints).
# Set to the public URL of this service, e.g. https://sec.hiluca.com
OIDC_AUDIENCE=https://sec.hiluca.com

# Shared secret for Abyssale & AI Expansion webhooks (path param).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ABYSSALE_WEBHOOK_SECRET=change_me_generate_a_random_secret

# CORS
# Production: use explicit allowed origins.
# CORS_ORIGINS=["https://app.hiluca.com","https://sec.hiluca.com"]
# Development:
CORS_ORIGINS=["*"]


# Activa la diversidad creativa a nivel de Adset (un Creative_Plan por Ad).
# false = Legacy_Path sin cambios.
USE_ADSET_CREATIVE_DIVERSITY=false

# Elementos de imagen decorativos: los elementos de tipo image de la plantilla cuyo
# nombre contiene alguno de estos patrones (sin distinguir mayúsculas) no reciben
# imagen generada. Formato JSON.
ADSET_DECORATIVE_IMAGE_PATTERNS=["degradado","gradient","overlay","mask","shape"]
