      "parameters": {
        "jsCode": "image_id = $('Edit Fields2').item.json.meta_ad_image_id\ntarget_meta_ad_id = $('Edit Fields2').item.json.meta_ad_id\n\nmeta_ads = $('Edit Fields2').item.json.meta_ads\nnew_meta_ads = []\nfor (m of meta_ads) {\n  if (m['id'] == target_meta_ad_id) {\n    m['image_prompts']['image_id'] = image_id\n    new_meta_ads.push(m)\n  } else {\n    new_meta_ads.push(m)\n  }\n}\nreturn { 'meta_ads' : new_meta_ads } "
