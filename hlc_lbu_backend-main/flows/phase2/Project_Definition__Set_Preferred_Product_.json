      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nproducts = _input.all()[0].json.attributes.products\n\ndesired_preferred = _('Edit Fields').all()[0].json.product_id\npreferred_product = {}\nfor b in products:\n  if b['Product'].id == int(desired_preferred):\n    b['Product'].preferred = 1\n    preferred_product = b\n  b['Product'].preferred = 0\n    \nreturn { 'products' : products, 'preferred_product': preferred_product }"
