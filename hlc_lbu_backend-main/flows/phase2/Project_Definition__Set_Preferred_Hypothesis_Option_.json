    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\noptions = _input.all()[0].json.attributes.hypothesis_builder_options\n\ndesired_preferred = _('Edit Fields').all()[0].json.option_id\npreferred_option = {}\nfor b in options:\n  b['Hypothesis_option'].preferred = 0\n  if b['Hypothesis_option'].id == int(desired_preferred):\n    b['Hypothesis_option'].preferred = 1\n    preferred_option = b\n    \nreturn { 'hypothesis_builder_options' : options, 'hypothesis_builder_preferred_option': preferred_option}"
      },
