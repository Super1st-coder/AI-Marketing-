# LucaCredit billing service — copy to .env and fill (never commit .env).

# Database — set DATABASE_URL directly, OR the DATABASE_* parts (assembled like Guide).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lucacredit
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME_DEFAULT=lucacredit

# Internal service auth — the shared secret Durval's video module / Guide send as X-Internal-Key.
# Generate a strong random value per environment; provisioned by Luis into the secret store.
LUCA_CREDITS_INTERNAL_KEY=

DEBUG=false
