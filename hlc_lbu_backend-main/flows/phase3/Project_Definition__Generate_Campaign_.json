              "value": "=PRODUCT DETAILS\n\nProduct Name: {{ $json.attributes.preferred_product.Product.Name }}\nProduct Description: {{ $json.attributes.preferred_product.Product.Details.Description }}\n\nCore_Characteristic: {{ $json.attributes.preferred_product.Product.Details.Core_Characteristic }}\nFeatures: {{ $json.attributes.preferred_product.Product.Details.Product_Details.Features }}\nCompetitive Advantages: {{ $json.attributes.preferred_product.Product.Details.Competitive_Advantage }}\nBenefits:\n{{  $json.attributes.preferred_product.Product.Details.Benefit_Related_to_Hypothesis }}\n",
