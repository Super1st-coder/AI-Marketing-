      "parameters": {
        "jsCode": "image_id = $input.first().json.id \ntarget_meta_ad_id = $input.first().json.meta_ad_id\nproject_id = $input.first().json.project_id\ntype = $input.first().json.type\n\nif (type == 'N')\n  meta_ads = $('Strapi2').first().json.attributes.meta_ads\nelse if (type == 'R')\n  meta_ads = $('Strapi2').first().json.attributes.meta_ads_remarketing\nelse\n  meta_ads = {}\n\nnew_meta_ads = []\nfor (m of meta_ads) {\n  if (m['id'] == target_meta_ad_id) {\n    m['image_prompts']['image_id'] = image_id\n    new_meta_ads.push(m)\n  } else {\n    new_meta_ads.push(m)\n  }\n}\nreturn { 'meta_ads' : new_meta_ads, 'type' : type, 'project_id' : project_id } "
