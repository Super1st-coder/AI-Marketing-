      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nbuyer_persons = _input.all()[0].json.attributes.buyer_persons\n\ndesired_preferred = _('Edit Fields').all()[0].json.buyer_person_id\npreferred_buyer_person = {}\nfor b in buyer_persons:\n  if b['Buyer_Persona'].id == int(desired_preferred):\n    b['Buyer_Persona'].preferred = 1\n    preferred_buyer_person = b\n  b['Buyer_Persona'].preferred = 0\n\n\nreturn { 'buyer_persons' : buyer_persons, 'preferred_buyer_person': preferred_buyer_person }"
