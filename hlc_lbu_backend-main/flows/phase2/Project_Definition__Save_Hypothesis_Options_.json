    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\n\noptions = _('Edit Fields').all()[0].json.hypothesis_builder_options\njson_options = json.loads(options)\n\nid = 0\ncurrent_ids = []\nfor j in json_options:\n  if not 'id' in j['Hypothesis_option']:\n    j['Hypothesis_option']['id'] = id   \n    j['Hypothesis_option']['preferred'] = 0\n    current_ids.append(id)\n  else:\n    current_ids.append(j['Hypothesis_option']['id'])\n    if not 'preferred' in j['Hypothesis_option']:\n      j['Hypothesis_option']['preferred'] = 0\n\n  while id in current_ids: \n    id += 1\n\nreturn {'json_output': json_options}"
      },
