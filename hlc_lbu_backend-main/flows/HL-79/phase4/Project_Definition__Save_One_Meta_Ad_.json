    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json \n\ntype = _('Edit Fields').item.json.type\n\nif type == 'N':\n  meta_ads = _input.all()[0].json.attributes.meta_ads\nelif type == 'R':\n  meta_ads = _input.all()[0].json.attributes.meta_ads_remarketing\nelse:\n  meta_ads = {}\n\n# meta_ads = _input.all()[0].json.attributes.meta_ads\n\none_meta_ad = _('Edit Fields').all()[0].json.meta_ad\none_meta_ad = json.loads(one_meta_ad)\n\nnew_meta_ads = []\nfor b in meta_ads:\n  if int(b.id) == int(one_meta_ad['id']) :\n    new_meta_ads.append(one_meta_ad)\n  else:\n    new_meta_ads.append(b)    \n  \n    \nreturn { 'meta_ads' : new_meta_ads, 'type' : type }"
      },
